# Skopíruj do .env a vyplň. Súbor .env sa neverzuje.

# --- povinné ---------------------------------------------------------------

# Podpisuje prihlasovacie tokeny. Vygeneruj náhodný reťazec, aspoň 32 znakov:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=zmen-ma-v-produkcii

# --- kľúče k cudzím službám ------------------------------------------------

# Tu žiadne nie sú. Každý používateľ si svoje vlastné vloží v appke,
# v Nastaveniach na karte Dáta. Ukladajú sa zašifrované pri jeho účte
# a šifra je odvodená z JWT_SECRET, takže po jeho zmene ich treba zadať
# znova. Vďaka tomu má každý účet aj vlastnú dennú kvótu volaní.

# Denná kvóta jedného kľúča k BrickEconomy je 100 volaní.
# Necháva sa rezerva na ručnú obnovu.
BRICKECONOMY_DAILY_LIMIT=100

# --- prevádzka -------------------------------------------------------------

# Za HTTPS nastav na true, inak sa cookie neuloží.
COOKIE_SECURE=false

# Len východisko pre novú inštaláciu. Registráciu potom otvára a zatvára
# správca v appke: Nastavenia → Aplikácia. Prvý účet prejde vždy.
ALLOW_REGISTRATION=true

# Hromadná obnova (tlačidlo v hornej lište) ťahá len ceny staršie než toto.
# Zdroj mení hodnoty zhruba raz za dva týždne, týždeň je rozumný kompromis.
# Ručná obnova jednej položky z detailu túto lehotu nepozerá.
# Jedna položka = jedno volanie, pokryje nový aj použitý stav.
PRICE_MAX_AGE_HOURS=168
PRICE_REFRESH_BUDGET=40

# Kam sa ukladajú vlastné fotky kusov. V kontajneri je to /app/data/photos,
# teda na tom istom zväzku ako databáza.
PHOTOS_DIR=./data/photos

# Počas vývoja beží frontend zvlášť na 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
